# Target LLM gateway (chat completions base URL)
LOCUST_HOST=https://api.openai.com

# Bearer token for the target API (required for authenticated endpoints)
LOCUST_AUTH_TOKEN=

# Optional: model and max_tokens for requests
LOCUST_LLM_MODEL=gpt-4o-mini
LOCUST_MAX_TOKENS=256

# Load shape (local / CLI)
LOCUST_USERS=100
LOCUST_SPAWN_RATE=10

# TrueFoundry: number of workers the master should expect (deploy_master.py)
LOCUST_EXPECT_WORKERS=10

# TrueFoundry workspace FQN (required for deploy_master.py and deploy_workers.py)
TFY_WORKSPACE_FQN=
